{
  "name": "film-gallery-mobile",
  "version": "4.0.5",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "wifi": "expo start --host lan",
    "wifi:clear": "expo start --host lan --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "postinstall": "patch-package",
    "eas:login": "node -e \"require('child_process').spawn('cmd', ['/c','npx','-y','eas-cli','login'], { stdio: 'inherit' })\"",
    "build:apk": "node -e \"require('child_process').spawn('cmd', ['/c','set','EAS_NO_VCS=1','&&','npx','-y','eas-cli','build','-p','android','--profile','preview'], { stdio: 'inherit' })\"",
    "build:aab": "node -e \"require('child_process').spawn('cmd', ['/c','set','EAS_NO_VCS=1','&&','npx','-y','eas-cli','build','-p','android','--profile','production'], { stdio: 'inherit' })\""
  },
  "dependencies": {
    "@babel/runtime": "^7.29.0",
    "@expo/vector-icons": "^15.0.3",
    "@filmgallery/api-client": "file:../packages/@filmgallery/api-client",
    "@filmgallery/shared": "file:../packages/shared",
    "@filmgallery/types": "file:../packages/@filmgallery/types",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/slider": "^5.1.1",
    "@react-navigation/bottom-tabs": "^6.0.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "date-fns": "^2.30.0",
    "expo": "~54.0.25",
    "expo-asset": "^12.0.12",
    "expo-build-properties": "^1.0.9",
    "expo-file-system": "~19.0.19",
    "expo-font": "14.0.12",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.7",
    "expo-location": "^19.0.8",
    "expo-media-library": "~18.2.0",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "lucide-react-native": "^0.563.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "^5.11.1",
    "react-native-paper-dates": "^0.22.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.1",
    "react-native-vector-icons": "^10.0.2",
    "react-native-vision-camera": "4.7.3",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.6.1",
    "react-native-worklets-core": "1.6.2",
    "react-native-zeroconf": "^0.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.1.0",
    "@react-native/metro-config": "^0.83.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "^54.0.7",
    "eas-cli": "^16.28.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.0"
  },
  "private": true
}
