# Project-wide npm config. Applied to `npm install` in this directory AND
# to recursive installs triggered by the root postinstall (cd client && npm
# install && cd ../server && npm install). Without this, CI fails on
# peer-dep conflicts in the React 18 / Electron 26 / canvas part of the tree.
#
# Local devs who hit the same peer-dep conflicts benefit automatically.
legacy-peer-deps=true
