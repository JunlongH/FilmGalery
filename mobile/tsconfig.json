{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["jest"],
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "expo-file-system/legacy": ["./types/expo-file-system-legacy.d.ts"]
    }
  },
  "include": [
    "src/**/*",
    "App.tsx",
    "__tests__/**/*",
    "types/**/*.d.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": ["node_modules", "android", "ios"]
}
