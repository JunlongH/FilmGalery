{
  "name": "@filmgallery/shared",
  "version": "1.0.0",
  "description": "Shared FilmLab processing utilities for client and server",
  "main": "index.js",
  "type": "commonjs",
  "exports": {
    ".": {
      "require": "./index.js",
      "default": "./index.js"
    },
    "./filmlab-core": "./filmlab-core.js",
    "./constants": "./filmLabConstants.js",
    "./constants/equipment": "./constants/equipment.js",
    "./coordTransform": {
      "types": "./coordTransform.d.ts",
      "require": "./coordTransform.js",
      "default": "./coordTransform.js"
    },
    "./portDiscovery": {
      "types": "./portDiscovery.d.ts",
      "require": "./portDiscovery.js",
      "default": "./portDiscovery.js"
    },
    "./serverCapabilities": "./serverCapabilities.js",
    "./sourcePathResolver": "./sourcePathResolver.js",
    "./rawUtils": "./rawUtils.js",
    "./geocode": {
      "types": "./geocode.d.ts",
      "require": "./geocode.js",
      "default": "./geocode.js"
    }
  },
  "private": true
}
