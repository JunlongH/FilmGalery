<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext permitted — required while the server runs HTTP (no TLS deployed
  yet). When Phase 2B #7 HTTPS is fully rolled out (server-side TLS + cert),
  this will be narrowed to domain-config for the server domain only.
  Tracking: docs/phase2-roadmap/phase-2b-security.md §「移动端配置收窄」.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
