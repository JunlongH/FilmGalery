{
  "name": "film-gallery-desktop",
  "version": "3.3.0",
  "private": true,
  "description": "Film Gallery — Electron desktop wrapper for the Film Manager app",
  "main": "electron-main.js",
  "author": "FilmGallery",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/shared",
    "packages/@filmgallery/*"
  ],
  "scripts": {
    "postinstall": "cd client && npm install --legacy-peer-deps && cd ../server && npm install --legacy-peer-deps",
    "dev:client": "cd client && npm start",
    "dev:server": "cd server && npm start",
    "dev:electron": "cross-env ELECTRON_DEV=true electron .",
    "dev:web": "concurrently -k -n SERVER,CLIENT \"npm:dev:server\" \"npm:dev:client\"",
    "dev:full": "concurrently -k -n SERVER,CLIENT,ELECTRON \"npm:dev:server\" \"npm:dev:client\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "dev": "concurrently -k -n CLIENT,ELECTRON \"npm:dev:client\" \"wait-on http://localhost:3000 && npm run dev:electron\"",
    "build-client": "cd client && npm run build",
    "build:gpu": "node electron-gpu/build.js",
    "build": "npm run build-client && npm run build:gpu",
    "rebuild:electron": "cd server && npm run rebuild:electron && cd ../packages/@filmgallery/libraw-native && npx @electron/rebuild",
    "pack": "npm run build && npm run rebuild:electron && electron-builder --dir",
    "dist": "npm run build && npm run rebuild:electron && electron-builder",
    "start": "electron .",
    "test": "jest --config tests/jest.config.js",
    "test:verbose": "jest --config tests/jest.config.js --verbose",
    "lint": "eslint server packages tests tools"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "43.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.yourorg.filmgallery",
    "productName": "FilmGallery",
    "files": [
      "client/build/**/*",
      "electron-main.js",
      "electron-preload.js",
      "electron-gpu/**/*",
      "assets/**/*",
      "package.json",
      "!**/film.db",
      "!server/uploads/**",
      "!**/.git/**",
      "!**/node_modules/**/test/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules/**",
          "!**/film.db",
          "!uploads/**",
          "!**/.cache/**",
          "!**/*.log"
        ]
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules",
        "filter": [
          "**/*",
          "!**/.bin/**",
          "!**/.cache/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/.github/**"
        ]
      },
      {
        "from": "packages",
        "to": "packages",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "directories": {
      "buildResources": "assets",
      "output": "dist_v9"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons",
      "category": "Graphics",
      "synopsis": "Film Photography Management Tool",
      "maintainer": "FilmGallery <filmgallery@example.com>",
      "executableName": "filmgallery"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
